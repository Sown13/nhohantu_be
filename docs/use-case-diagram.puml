@startuml TC_Book_Use_Case

left to right direction

skinparam backgroundColor white
skinparam usecase {
    BackgroundColor #E8D5F0
    BorderColor #9B59B6
}
skinparam actor {
    BorderColor #333333
}
skinparam rectangle {
    BackgroundColor #E8E0F0
    BorderColor #333333
    BorderThickness 2
}

actor "Guest" as Guest
actor "Customer" as Customer
actor "Admin" as Admin

rectangle "TC Book System" {
    usecase "Browse/Search Products" as UC_Browse
    usecase "View Product Detail" as UC_Detail
    usecase "Register" as UC_Register
    usecase "Login/Logout" as UC_Auth
    usecase "Manage Cart" as UC_Cart
    usecase "Place Order" as UC_Order
    usecase "Submit Review" as UC_Review
    usecase "Manage Products" as UC_MngProduct
    usecase "Manage Orders" as UC_MngOrder
    usecase "Manage Users" as UC_MngUser
}

Guest --> UC_Browse
Guest --> UC_Detail
Guest --> UC_Register

Customer --> UC_Auth
Customer --> UC_Cart
Customer --> UC_Order
Customer --> UC_Review

Admin --> UC_MngProduct
Admin --> UC_MngOrder
Admin --> UC_MngUser

@enduml
